<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>IGTAP.EngineSim.Runtime</AssemblyName>
    <RootNamespace>IGTAP.EngineSim</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Optimize>true</Optimize>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GameManaged>$(IgtapGame)/IGTAPfullGame_Data/Managed</GameManaged>
    <GameAssembly>$(GameManaged)/Assembly-CSharp.dll</GameAssembly>
    <GameAssembly Condition="Exists('$(GameManaged)/Assembly-CSharp.ORIGINAL.dll')">$(GameManaged)/Assembly-CSharp.ORIGINAL.dll</GameAssembly>
    <RetargetedGame>$(MSBuildThisFileDirectory)../obj/game/Assembly-CSharp.dll</RetargetedGame>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS0414</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Shared/MacroEngine.cs" Link="Shared/MacroEngine.cs" />
    <Compile Include="../Shared/MacroModels.cs" Link="Shared/MacroModels.cs" />
    <Compile Include="../Shared/FieldState.cs" Link="Shared/FieldState.cs" />
    <Compile Include="../Shared/FullTas.cs" Link="Shared/FullTas.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Shim/IGTAP.UnityShim.csproj" />
    <ProjectReference Include="../Box2D/IGTAP.Box2D.csproj" />
    <ProjectReference Include="../Prep/IGTAP.EngineSim.Prep.csproj" ReferenceOutputAssembly="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(RetargetedGame)" Private="true" />
  </ItemGroup>

  <Target Name="RetargetGame" AfterTargets="ResolveProjectReferences" BeforeTargets="ResolveAssemblyReferences"
          Inputs="$(GameAssembly);../cuts.txt;../hooks.txt;../Shim/bin/$(Configuration)/net10.0/IGTAP.UnityShim.dll"
          Outputs="$(RetargetedGame)">
    <Exec Command="dotnet &quot;$(MSBuildThisFileDirectory)../Prep/bin/$(Configuration)/net10.0/IGTAP.EngineSim.Prep.dll&quot; retarget &quot;$(GameAssembly)&quot; &quot;$(MSBuildThisFileDirectory)../obj/game&quot; &quot;$(MSBuildThisFileDirectory)../cuts.txt&quot; &quot;$(MSBuildThisFileDirectory)../hooks.txt&quot; &quot;$(MSBuildThisFileDirectory)../Shim/bin/$(Configuration)/net10.0/IGTAP.UnityShim.dll&quot;" />
  </Target>
</Project>
